# PostgreSQL connection string (required by the API routes)
DATABASE_URL=postgresql://user:password@localhost:5432/taller
# Set true when your PostgreSQL host requires TLS.
DATABASE_SSL=false

# Public canonical HTTPS URL of the deployed site
SITE_URL=http://localhost:3000

# Mercado Pago test credentials for sandbox checkout
MP_ACCESS_TOKEN=TEST-REPLACE_WITH_TEST_ACCESS_TOKEN
MP_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Optional only if rendering Mercado Pago's Wallet Brick
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Private product administration. Generate a password hash with:
# .\scripts\generate-admin-hash.ps1
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate at least 32 random characters, e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
